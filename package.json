{
  "name": "bharat-ai-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node backend/server.mjs",
